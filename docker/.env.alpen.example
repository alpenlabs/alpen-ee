# Template for the alpen-client compose env files (.env.alpen,
# .env.alpen-client). Key/param generation moved to the strata repo with the
# repo split; a local flow for filling these in returns with the post-split
# params tooling (see the repo-split notes).
#
# Only what the compose files interpolate. Node settings live in the
# --alpen-config TOML mounted into the container (see docker/configs/).

# Schnorr key the sequencer signs gossip messages and DA reveals with. Read
# straight from the environment by alpen-client so it never lands in a config
# file.
SEQUENCER_PRIVATE_KEY=

# secp256k1 pubkey of the sequencer's reth P2P key, used to build the enode://
# URL its peers dial. Not a setting -- it is derived from the mounted
# seq-p2p.hex and emitted by the same key generation step, so regenerating
# that key means updating this too. A stale value fails the RLPx handshake.
#
# It belongs here rather than in --alpen-config because peering is reth's
# domain, like --port and --nat.
SEQ_P2P_PUBKEY=

# Generated params artifact, mounted into the container.
ALPEN_PARAMS_PATH=/app/configs/generated/alpen-params.json

RUST_LOG=info
