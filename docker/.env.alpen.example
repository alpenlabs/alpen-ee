# Template for the alpen-client compose env files (.env.alpen,
# .env.alpen-client). Key/param generation moved to the strata repo with the
# repo split; a local flow for filling these in returns with the post-split
# params tooling (see the repo-split notes).
#
# These variables feed docker/alpen-client/entrypoint.sh, which generates
# this node's --alpen-config TOML file from them at container startup --
# they're no longer translated 1:1 into CLI flags.

SEQUENCER_PRIVATE_KEY=
SEQUENCER_PUBKEY=

SEQ_P2P_PUBKEY=
FN_P2P_PUBKEY=

ALPEN_PARAMS_PATH=/app/configs/generated/alpen-params.json

# DA magic bytes used when generating alpen-params.json (carried in the
# artifact's blob_spec; not a runtime flag).
EE_DA_MAGIC_BYTES=ALPN
L1_REORG_SAFE_DEPTH=1
# Must match the genesis height used when generating params.
# Set via GENESIS_L1_HEIGHT when running init-network.sh.
GENESIS_L1_HEIGHT=0
BATCH_SEALING_BLOCK_COUNT=5

BITCOIND_RPC_USER=rpcuser
BITCOIND_RPC_PASSWORD=rpcpassword
BITCOIND_RPC_PORT=18443
# Cross-checked against the connected bitcoind's own reported network at
# startup; alpen-client refuses to start on a mismatch.
BITCOIN_NETWORK=regtest

STRATA_RPC_PORT=8432

SEQ_HTTP_PORT=8545
SEQ_WS_PORT=8546
SEQ_P2P_PORT=30303

FN_HTTP_PORT=9545
FN_WS_PORT=9546
FN_P2P_PORT=31303

RUST_LOG=info
