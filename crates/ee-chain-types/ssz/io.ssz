import strata_acct_types
import strata_predicate

### Max entries per execution span.  These are generous upper bounds; see
### SPS-ol-da-structure for the canonical limits.
MAX_SUBJECT_DEPOSITS = 1 << 16
MAX_OUTPUT_TRANSFERS = 1 << 16
MAX_OUTPUT_MESSAGES = 1 << 16

### Describes data for a simple deposit to a subject within an EE.
class SubjectDepositData(Container):
    ### Destination subject ID within the execution environment
    dest: strata_acct_types.SubjectId

    ### Native asset value deposited (satoshis)
    value: strata_acct_types.BitcoinAmount

### Inputs from the OL to the EE processed in an execution span.
class ExecInputs(Container):
    ### Subject deposits from L1 or cross-layer transfers
    subject_deposits: List[SubjectDepositData, MAX_SUBJECT_DEPOSITS]

### Describes a transfer output from an EE subject to an OL account.
class OutputTransfer(Container):
    ### Destination orchestration layer account ID
    dest: strata_acct_types.AccountId

    ### Native asset value transferred (satoshis)
    value: strata_acct_types.BitcoinAmount

### Describes a transfer output from an EE subject to an OL account.
class OutputMessage(Container):
    ### Destination orchestration layer account ID
    dest: strata_acct_types.AccountId

    ### Message payload carried, both value and data.
    #~# external_kind: container
    payload: strata_acct_types.MsgPayload

### Optional rotation of the account's update predicate key.
###
### Empty for ordinary blocks. Set when the block consumes a queued
### `PredicateRotation` pending input, committing to the key that verifies
### the update containing this block.
###
### This is a StableContainer because Optional fields are only allowed in
### StableContainers, not plain Containers, so we need this wrapper to make
### the predicate optional. The spare capacity also lets future optional
### fields slot in without changing the encoding of existing data.
#~# derive: std::default::Default
class ExecNewPredicate(StableContainer[4]):
    #~# external_kind: container
    predicate: Optional[strata_predicate.PredicateKey]

### Outputs from an EE to the OL produced in an execution span.
class ExecOutputs(Container):
    ### Native asset transfers to OL accounts
    output_transfers: List[OutputTransfer, MAX_OUTPUT_TRANSFERS]

    ### Messages sent to OL accounts (with data payload)
    #~# external_kind: container
    output_messages: List[OutputMessage, MAX_OUTPUT_MESSAGES]

    ### New update predicate declared by this block, if it consumed a queued
    ### rotation.
    new_predicate: ExecNewPredicate
